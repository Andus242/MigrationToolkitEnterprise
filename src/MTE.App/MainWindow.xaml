<Window x:Class="MTE.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Migration Toolkit Enterprise"
        Height="720"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,8">

            <StackPanel>
                <TextBlock Text="Migration Toolkit Enterprise"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock Text="Enterprise PC Migration"
                           FontSize="12"
                           Opacity="0.65"
                           Margin="0,2,0,0"/>
            </StackPanel>

        </Grid>


        <!-- ========================================================= -->
        <!-- DESTINATION -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
                Padding="10"
                Margin="0,0,0,8"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Migration Destination"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <Button Grid.Row="0"
                        Grid.Column="1"
                        Content="REFRESH DRIVES"
                        Command="{Binding RefreshDrivesCommand}"
                        Width="125"
                        Height="28"/>


                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="2"
                      Margin="0,6,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableDrives}"
                              SelectedItem="{Binding SelectedDestination}"
                              DisplayMemberPath="DisplayName"
                              Height="30"
                              FontSize="13"/>

                    <CheckBox Grid.Column="1"
                              Content=" Verify destination"
                              IsChecked="{Binding VerifyBeforeMigration, Mode=TwoWay}"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              FontSize="13"/>

                </Grid>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- USER PROFILES - MAIN EXPANDING AREA -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
                Padding="10"
                Margin="0,0,0,8"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- PROFILE HEADER -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel>

                        <TextBlock Text="User Profiles"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding ProfileSelectionSummary}"
                                   FontSize="11"
                                   Opacity="0.65"
                                   Margin="0,1,0,0"/>

                        <TextBlock Text="{Binding EstimatedMigrationSizeDisplay, StringFormat=Estimated migration size: {0}}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Opacity="0.75"
                                   Margin="0,2,0,0"/>

                    </StackPanel>


                    <Button Grid.Column="1"
                            Content="REFRESH PROFILES"
                            Command="{Binding DiscoverProfilesCommand}"
                            Width="140"
                            Height="28"/>

                </Grid>


                <!-- PROFILE LIST -->

                <ListView Grid.Row="1"
                          ItemsSource="{Binding AvailableProfiles}"
                          BorderThickness="0"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <ListView.View>

                        <GridView>

                            <!-- PROFILE SELECTION -->

                            <GridViewColumn Width="35">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>


                            <!-- PROFILE -->

                            <GridViewColumn Header="Profile"
                                            Width="150">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <StackPanel Margin="2">

                                            <TextBlock Text="{Binding UserName}"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="{Binding SizeDisplay}"
                                                       FontSize="10"
                                                       Opacity="0.65"/>

                                        </StackPanel>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>


                            <!-- LOCATION -->

                            <GridViewColumn Header="Location"
                                            Width="300"
                                            DisplayMemberBinding="{Binding ProfilePath}"/>


                            <!-- TYPE -->

                            <GridViewColumn Header="Type"
                                            Width="115">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock>

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Text"
                                                            Value="User Profile"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsCurrentUser}"
                                                                     Value="True">

                                                            <Setter Property="Text"
                                                                    Value="Current User"/>

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding IsSystemProfile}"
                                                                     Value="True">

                                                            <Setter Property="Text"
                                                                    Value="System Profile"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>


                            <!-- COPY OPTIONS -->

                            <GridViewColumn Header="Copy Options"
                                            Width="390">

                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>

                                        <StackPanel Margin="2">

                                            <!-- MODE DROPDOWN -->

                                            <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CopyModes}"
                                                      SelectedItem="{Binding CopyMode, Mode=TwoWay}"
                                                      Width="180"
                                                      Height="26"
                                                      HorizontalAlignment="Left"/>

                                            <!-- WHOLE PROFILE -->

                                            <StackPanel Margin="0,5,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CopyWholeProfile}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <TextBlock Text="{Binding SelectedFoldersDisplay}"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding SizeDisplay, StringFormat=Estimated size: {0}}"
                                                           Opacity="0.75"/>
                                            </StackPanel>

                                            <!-- SELECTED FOLDERS -->

                                            <StackPanel Margin="0,5,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FolderSelectionEnabled}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <CheckBox Grid.Row="0"
                                                              Grid.Column="0"
                                                              Content="Desktop"
                                                              IsChecked="{Binding CopyDesktop, Mode=TwoWay}"
                                                              Margin="0,1,8,3"/>

                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="1"
                                                               Text="{Binding DesktopSizeDisplay}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,1,0,3"
                                                               Opacity="0.75"/>

                                                    <CheckBox Grid.Row="1"
                                                              Grid.Column="0"
                                                              Content="Documents"
                                                              IsChecked="{Binding CopyDocuments, Mode=TwoWay}"
                                                              Margin="0,1,8,3"/>

                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="1"
                                                               Text="{Binding DocumentsSizeDisplay}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,1,0,3"
                                                               Opacity="0.75"/>

                                                    <CheckBox Grid.Row="2"
                                                              Grid.Column="0"
                                                              Content="Downloads"
                                                              IsChecked="{Binding CopyDownloads, Mode=TwoWay}"
                                                              Margin="0,1,8,3"/>

                                                    <TextBlock Grid.Row="2"
                                                               Grid.Column="1"
                                                               Text="{Binding DownloadsSizeDisplay}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,1,0,3"
                                                               Opacity="0.75"/>

                                                    <CheckBox Grid.Row="3"
                                                              Grid.Column="0"
                                                              Content="Pictures"
                                                              IsChecked="{Binding CopyPictures, Mode=TwoWay}"
                                                              Margin="0,1,8,3"/>

                                                    <TextBlock Grid.Row="3"
                                                               Grid.Column="1"
                                                               Text="{Binding PicturesSizeDisplay}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,1,0,3"
                                                               Opacity="0.75"/>

                                                    <CheckBox Grid.Row="4"
                                                              Grid.Column="0"
                                                              Content="Music"
                                                              IsChecked="{Binding CopyMusic, Mode=TwoWay}"
                                                              Margin="0,1,8,3"/>

                                                    <TextBlock Grid.Row="4"
                                                               Grid.Column="1"
                                                               Text="{Binding MusicSizeDisplay}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,1,0,3"
                                                               Opacity="0.75"/>

                                                    <CheckBox Grid.Row="5"
                                                              Grid.Column="0"
                                                              Content="Videos"
                                                              IsChecked="{Binding CopyVideos, Mode=TwoWay}"
                                                              Margin="0,1,8,3"/>

                                                    <TextBlock Grid.Row="5"
                                                               Grid.Column="1"
                                                               Text="{Binding VideosSizeDisplay}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,1,0,3"
                                                               Opacity="0.75"/>

                                                    <CheckBox Grid.Row="6"
                                                              Grid.Column="0"
                                                              Content="Favorites"
                                                              IsChecked="{Binding CopyFavorites, Mode=TwoWay}"
                                                              Margin="0,1,8,3"/>

                                                    <TextBlock Grid.Row="6"
                                                               Grid.Column="1"
                                                               Text="{Binding FavoritesSizeDisplay}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,1,0,3"
                                                               Opacity="0.75"/>

                                                    <Border Grid.Row="7"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            BorderThickness="0,1,0,0"
                                                            Margin="0,4,0,0"
                                                            Padding="0,5,0,0">

                                                        <StackPanel Orientation="Horizontal">

                                                            <TextBlock Text="Selected folders:"
                                                                       FontWeight="SemiBold"/>

                                                            <TextBlock Text="{Binding SelectedFoldersSizeDisplay}"
                                                                       FontWeight="SemiBold"
                                                                       Margin="6,0,0,0"/>

                                                        </StackPanel>

                                                    </Border>

                                                </Grid>

                                            </StackPanel>

                                        </StackPanel>

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>
                        </GridView>

                    </ListView.View>

                </ListView>


                <!-- PROFILE ACTIONS -->

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,6,0,0">

                    <Button Content="SELECT ALL"
                            Command="{Binding SelectAllProfilesCommand}"
                            Width="85"
                            Height="25"
                            Margin="0,0,6,0"/>

                    <Button Content="CLEAR ALL"
                            Command="{Binding ClearAllProfilesCommand}"
                            Width="85"
                            Height="25"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- STATUS + PROGRESS -->
        <!-- ========================================================= -->

        <Border Grid.Row="3"
                Padding="8"
                Margin="0,0,0,8"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>


                <!-- MIGRATION STATUS TITLE -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Migration Status"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="Purple"
                           VerticalAlignment="Center"/>


                <!-- PROGRESS BAR -->

                <ProgressBar Grid.Row="0"
                             Grid.Column="1"
                             Height="20"
                             Margin="10,0,8,0"
                             VerticalAlignment="Center"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="False"
                             Value="{Binding ProgressPercentage, Mode=OneWay}"/>


                <!-- PERCENTAGE -->

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="{Binding ProgressPercentage, StringFormat={}{0:0}%}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"/>


                <!-- CURRENT MIGRATION STATUS
                     POSITIONED DIRECTLY BELOW THE PROGRESS BAR -->

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding CurrentOperation}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="Purple"
                           Opacity="1"
                           Margin="10,8,0,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- FINAL MIGRATION METRICS -->
                <Grid Grid.Row="2"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="10,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding MigrationTotalFiles, StringFormat=Total Files: {0:N0}}"
                               FontSize="11"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding MigrationTotalBytesDisplay, StringFormat=Total Size: {0}}"
                               FontSize="11"/>

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="{Binding MigrationCopiedFiles, StringFormat=Copied Files: {0:N0}}"
                               FontSize="11"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{Binding MigrationCopiedBytesDisplay, StringFormat=Copied Size: {0}}"
                               FontSize="11"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding MigrationVerifiedFiles, StringFormat=Verified: {0:N0}}"
                               FontSize="11"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Text="{Binding MigrationFailedFiles, StringFormat=Failed: {0:N0}}"
                               FontSize="11"/>
                </Grid>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- ACTION BUTTONS - ALWAYS VISIBLE -->
        <!-- ========================================================= -->

        <Border Grid.Row="4"
                Padding="8"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- LEFT STATUS -->

                <TextBlock Grid.Column="0"
                           Text="Ready"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Opacity="0.75"/>


                <!-- VERIFICATION -->

                <Button Grid.Column="1"
                        Content="RUN VERIFICATION"
                        Command="{Binding RunVerificationCommand}"
                        Width="155"
                        Height="36"
                        Margin="0,0,6,0"/>


                <!-- MIGRATION -->

                <Button Grid.Column="2"
                        Content="START MIGRATION"
                        Command="{Binding StartMigrationCommand}"
                        Width="155"
                        Height="36"
                        Margin="0,0,6,0"/>


                <!-- CANCEL -->

                <Button Grid.Column="3"
                        Width="105"
                        Height="36"
                        Command="{Binding CancelMigrationCommand}"
                        Background="Firebrick"
                        BorderBrush="DarkRed"
                        BorderThickness="1"
                        Padding="0">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                    <TextBlock Text="CANCEL"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Button>

            </Grid>

        </Border>

    </Grid>

</Window>
